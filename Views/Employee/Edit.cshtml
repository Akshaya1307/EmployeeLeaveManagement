@model EmployeeLeaveManagement.Models.User

@{
    ViewData["Title"] = "Edit Employee";

    bool isMasterAdmin = User.IsInRole("MasterAdmin");
    bool isAdmin = User.IsInRole("Admin");
}

<div class="card shadow-sm">

    <div class="card-header bg-warning text-dark">
        <h3 class="mb-0">
            <i class="fas fa-user-edit"></i>
            Edit Employee
        </h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            <input asp-for="EmployeeID" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="PasswordHash" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <!-- Employee Code -->
                <div class="col-md-6 mb-3">
                    <label asp-for="EmployeeCode" class="form-label"></label>
                    <input asp-for="EmployeeCode" class="form-control" />
                    <span asp-validation-for="EmployeeCode"
                          class="text-danger"></span>
                </div>

                <!-- Role -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Role" class="form-label"></label>

                    <select asp-for="Role"
                            id="roleDropdown"
                            class="form-select">

                        @if (isMasterAdmin)
                        {
                            <option value="Admin">Admin</option>
                        }

                        <option value="Employee">Employee</option>

                    </select>

                    <span asp-validation-for="Role"
                          class="text-danger"></span>

                </div>

                <!-- First Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <!-- Last Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <!-- Join Date -->
                <div class="col-md-6 mb-3">
                    <label asp-for="JoinDate" class="form-label"></label>
                    <input asp-for="JoinDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="JoinDate"
                          class="text-danger"></span>
                </div>

                <!-- Reporting Admin -->
                <div class="col-md-6 mb-3">

                    <label asp-for="ManagerID"
                           class="form-label">
                        Reporting Admin
                    </label>

                    <select asp-for="ManagerID"
                            id="managerDropdown"
                            class="form-select">

                        <option value="">
                            -- Select Reporting Admin --
                        </option>

                        @if (ViewBag.Admins != null)
                        {
                            foreach (var admin in (List<EmployeeLeaveManagement.Models.User>)ViewBag.Admins)
                            {
                                if (admin.EmployeeID != Model.EmployeeID)
                                {
                                    <option value="@admin.EmployeeID">
                                        @admin.FullName (@admin.EmployeeCode)
                                    </option>
                                }
                            }
                        }

                    </select>

                    <small id="managerHelp"
                           class="text-muted">
                        Select the Reporting Admin.
                    </small>

                </div>

                <!-- Status -->
                <div class="col-md-6 mb-3">

                    <label asp-for="IsActive"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="IsActive"
                            class="form-select">

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>

                    </select>

                </div>

            </div>

            <hr />

            <button type="submit"
                    class="btn btn-warning">
                <i class="fas fa-save"></i>
                Update Employee
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

<script>

document.addEventListener("DOMContentLoaded", function () {

    const role = document.getElementById("roleDropdown");
    const manager = document.getElementById("managerDropdown");
    const help = document.getElementById("managerHelp");

    const isAdmin =
        @(User.IsInRole("Admin").ToString().ToLower());

    function updateUI() {

        if (isAdmin) {

            manager.disabled = true;

            help.innerText =
                "Reporting Admin cannot be changed by an Admin.";

            return;
        }

        if (role.value === "Admin") {

            manager.disabled = true;
            manager.value = "";

            help.innerText =
                "Admins report directly to the Master Admin.";

        }
        else {

            manager.disabled = false;

            help.innerText =
                "Select the Reporting Admin.";

        }

    }

    role.addEventListener("change", updateUI);

    updateUI();

});

</script>
}
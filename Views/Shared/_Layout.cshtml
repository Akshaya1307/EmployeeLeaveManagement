<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Leave Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css"
          rel="stylesheet" />

    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        }

        .sidebar .nav-link {
            color: rgba(255,255,255,.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 8px;
            transition: .3s;
        }

        .sidebar .nav-link:hover {
            background: rgba(255,255,255,.12);
            color: #fff;
        }

        .sidebar .nav-link.active {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

        .sidebar .nav-link i {
            width: 20px;
            margin-right: 10px;
        }

        .sidebar .nav-link.disabled {
            color: rgba(255,255,255,.45);
            cursor: not-allowed;
            pointer-events: none;
        }

        .main-content {
            min-height: 100vh;
            background: #f8f9fa;
        }

        .navbar-top {
            background: #fff;
            box-shadow: 0 2px 4px rgba(0,0,0,.08);
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,.05);
        }

        .btn-primary {
            background: linear-gradient(135deg,#667eea,#764ba2);
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,.2);
        }
    </style>

</head>

<body>

@if (User.Identity!.IsAuthenticated)
{
    <div class="container-fluid">

        <div class="row">

            <!-- ================= Sidebar ================= -->

            <div class="col-md-2 p-0 sidebar">

                <div class="text-center p-4">

                    <i class="fas fa-calendar-alt fa-3x text-white"></i>

                    <h5 class="text-white mt-2">
                        Leave Management
                    </h5>

                </div>

                <nav class="nav flex-column">

                    <!-- Dashboard -->
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       href="@Url.Action("Index", "Home")">

                        <i class="fas fa-home"></i>

                        Dashboard

                    </a>


                    <!-- Employee Features -->
                    @if (!User.IsInRole("MasterAdmin"))
                    {
                        <!-- Apply Leave -->
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Apply" ? "active" : "")"
                           href="@Url.Action("Apply", "Leave")">

                            <i class="fas fa-plus-circle"></i>

                            Apply Leave

                        </a>


                        <!-- My Requests -->
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyRequests" ? "active" : "")"
                           href="@Url.Action("MyRequests", "Leave")">

                            <i class="fas fa-list"></i>

                            My Requests

                        </a>


                        <!-- Leave Balance -->
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LeaveBalance" ? "active" : "")"
                           href="@Url.Action("LeaveBalance", "Leave")">

                            <i class="fas fa-chart-line"></i>

                            Leave Balance

                        </a>
                    }


                    <!-- Admin / Master Admin Features -->
                    @if (User.IsInRole("Admin") || User.IsInRole("MasterAdmin"))
                    {
                        <!-- Pending Approvals -->
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PendingRequests" ? "active" : "")"
                           href="@Url.Action("PendingRequests", "Leave")">

                            <i class="fas fa-clock"></i>

                            Pending Approvals

                        </a>


                        <!-- Manage Employees -->
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
                           href="@Url.Action("Index", "Employee")">

                            <i class="fas fa-users"></i>

                            Manage Employees

                        </a>


                        <!-- Settings - Not implemented yet -->
                        <span class="nav-link disabled"
                              title="Settings will be available soon">

                            <i class="fas fa-cog"></i>

                            Settings

                        </span>
                    }

                </nav>

            </div>


            <!-- ================= Main Content ================= -->

            <div class="col-md-10 p-0 main-content">

                <!-- Top Navbar -->
                <nav class="navbar navbar-expand-lg navbar-top p-3">

                    <div class="container-fluid">

                        <span class="navbar-text">

                            <i class="fas fa-calendar-alt"></i>

                            Employee Leave Management System

                        </span>


                        <div class="ms-auto">

                            <div class="dropdown">

                                <button class="btn btn-light dropdown-toggle"
                                        data-bs-toggle="dropdown">

                                    <i class="fas fa-user-circle"></i>

                                    @User.Identity.Name

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end">

                                    <!-- Profile -->
                                    <li>
                                        <span class="dropdown-item-text">
                                            <i class="fas fa-user"></i>
                                            Profile
                                        </span>
                                    </li>


                                    <!-- Change Password -->
                                    <li>
                                        <span class="dropdown-item-text">
                                            <i class="fas fa-key"></i>
                                            Change Password
                                        </span>
                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- Logout -->
                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item">

                                                <i class="fas fa-sign-out-alt"></i>

                                                Logout

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </nav>


                <!-- Page Content -->
                <div class="p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">

                            @TempData["Success"]

                            <button class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">

                            @TempData["Error"]

                            <button class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    @RenderBody()

                </div>

            </div>

        </div>

    </div>
}
else
{
    @RenderBody()
}


<!-- Scripts -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
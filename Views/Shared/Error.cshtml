@{
    ViewData["Title"] = "Error";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: 64px;"></i>
                    <h1 class="mt-3">Oops! Something went wrong</h1>
                    <p class="lead">We encountered an error while processing your request.</p>
                    <p>Please try again later or contact support if the problem persists.</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
                        <i class="fas fa-home"></i> Go Back Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>